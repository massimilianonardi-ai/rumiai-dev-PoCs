RumiAI_TEST_PASS=0
RumiAI_TEST_FAIL=0
RumiAI_TEST_SKIP=0

RumiAI_test_pass()
{
  printf -- 'PASS %s\n' "$1"
  RumiAI_TEST_PASS=$((RumiAI_TEST_PASS + 1))
}

RumiAI_test_fail()
{
  printf -- 'FAIL %s%s\n' "$1" "${2:+: $2}"
  RumiAI_TEST_FAIL=$((RumiAI_TEST_FAIL + 1))
}

RumiAI_test_skip()
{
  printf -- 'SKIP %s%s\n' "$1" "${2:+: $2}"
  RumiAI_TEST_SKIP=$((RumiAI_TEST_SKIP + 1))
}

RumiAI_test_status()
{
  RumiAI_test_label=$1
  RumiAI_test_expected=$2
  shift 2

  RumiAI_test_out=$RumiAI_TEST_WORK/$RumiAI_test_label.out
  RumiAI_test_err=$RumiAI_TEST_WORK/$RumiAI_test_label.err
  "$@" >"$RumiAI_test_out" 2>"$RumiAI_test_err"
  RumiAI_test_got=$?

  if [ "$RumiAI_test_got" -eq "$RumiAI_test_expected" ]
  then
    RumiAI_test_pass "$RumiAI_test_label"
  else
    RumiAI_test_fail "$RumiAI_test_label" "status=$RumiAI_test_got expected=$RumiAI_test_expected"
  fi
}

RumiAI_test_status_with_stderr()
{
  RumiAI_test_label=$1
  RumiAI_test_expected=$2
  RumiAI_test_marker=$3
  shift 3

  RumiAI_test_out=$RumiAI_TEST_WORK/$RumiAI_test_label.out
  RumiAI_test_err=$RumiAI_TEST_WORK/$RumiAI_test_label.err

  "$@" >"$RumiAI_test_out" 2>"$RumiAI_test_err"
  RumiAI_test_got=$?
  RumiAI_test_stderr=$(cat -- "$RumiAI_test_err")

  case $RumiAI_test_stderr in
    *"$RumiAI_test_marker"*)
      RumiAI_test_marker_ok=1
      ;;
    *)
      RumiAI_test_marker_ok=
      ;;
  esac

  if [ "$RumiAI_test_got" -eq "$RumiAI_test_expected" ] && [ -n "$RumiAI_test_marker_ok" ]
  then
    RumiAI_test_pass "$RumiAI_test_label"
  else
    RumiAI_test_fail "$RumiAI_test_label" "status=$RumiAI_test_got expected=$RumiAI_test_expected marker=$RumiAI_test_marker"
    [ ! -s "$RumiAI_test_err" ] || sed 's/^/  stderr: /' "$RumiAI_test_err"
  fi
}

RumiAI_test_output_has()
{
  RumiAI_test_label=$1
  RumiAI_test_file=$2
  RumiAI_test_marker=$3
  RumiAI_test_content=$(cat -- "$RumiAI_test_file")

  case $RumiAI_test_content in
    *"$RumiAI_test_marker"*)
      RumiAI_test_pass "$RumiAI_test_label"
      ;;
    *)
      RumiAI_test_fail "$RumiAI_test_label" "missing=$RumiAI_test_marker"
      ;;
  esac
}

RumiAI_test_fresh_subject()
{
  RumiAI_test_name=$1
  RumiAI_TEST_SUBJECT=$RumiAI_TEST_WORK/$RumiAI_test_name/product
  mkdir -p -- "$RumiAI_TEST_SUBJECT" || return 1

  cp -- "$RumiAI_TEST_PRODUCT_ROOT/rumiai-os" "$RumiAI_TEST_SUBJECT/rumiai-os" || return 1

  for RumiAI_test_dir in bin conf lang lib
  do
    [ -d "$RumiAI_TEST_PRODUCT_ROOT/$RumiAI_test_dir" ] || return 1
    cp -R -- "$RumiAI_TEST_PRODUCT_ROOT/$RumiAI_test_dir" "$RumiAI_TEST_SUBJECT/$RumiAI_test_dir" || return 1
  done

  return 0
}

RumiAI_test_summary()
{
  printf -- 'SUMMARY pass=%s fail=%s skip=%s\n' \
    "$RumiAI_TEST_PASS" "$RumiAI_TEST_FAIL" "$RumiAI_TEST_SKIP"
  [ "$RumiAI_TEST_FAIL" -eq 0 ]
}
