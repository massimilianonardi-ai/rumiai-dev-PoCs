#!/bin/sh

set -u

fail()
{
  printf '%s\n' "FAIL: $*" >&2
  exit 1
}

prepare_relocatable_fixture()
{
  tmp=${TMPDIR:-/tmp}/"rumiai poc 012 % \$ & ; \" ' \\ $$"
  root=$tmp/"RumiAI root % \$ & ; \" ' \\"
  bootstrap=$root/m
  command=$root/"bin/sys/host command"
  bootstrap_marker=$bootstrap.bootstrap-marker
  command_marker=$command.command-marker

  mkdir -p "$root/bin/sys" || fail 'cannot prepare relocatable fixture'

  cat > "$bootstrap" <<'EOF_BOOTSTRAP'
#!/bin/sh
printf '%s\n' "$0" > "$0.bootstrap-marker"
[ "$#" -eq 1 ] || exit 91
exec "$1"
EOF_BOOTSTRAP

  cat > "$command" <<'EOF_COMMAND'
#!/bin/sh
printf '%s\n' "$0" > "$0.command-marker"
trap 'exit 0' TERM INT HUP
while :
do
  sleep 1
done
EOF_COMMAND

  chmod 700 "$bootstrap" "$command" || fail 'cannot make relocatable fixture executable'
}

assert_exact_invocation()
{
  [ -s "$bootstrap_marker" ] || fail 'bootstrap marker missing'
  [ -s "$command_marker" ] || fail 'command marker missing'

  observed_bootstrap=$(cat "$bootstrap_marker") || fail 'cannot read bootstrap marker'
  observed_command=$(cat "$command_marker") || fail 'cannot read command marker'

  [ "$observed_bootstrap" = "$bootstrap" ] ||
    fail "bootstrap argv/path mismatch: expected=$bootstrap observed=$observed_bootstrap"
  [ "$observed_command" = "$command" ] ||
    fail "command argv/path mismatch: expected=$command observed=$observed_command"
}

systemd_exec_arg()
{
  [ "$#" -eq 1 ] || return 2
  case "$1" in
    /*) : ;;
    *) return 1 ;;
  esac

  systemd_exec_arg_rest=${1#/}

  printf '"/'
  LC_ALL=C printf '%s' "$systemd_exec_arg_rest" |
    od -An -tx1 |
    awk '{
      for (i = 1; i <= NF; i++)
        printf "\\x%s", $i
    }' || return 1
  printf '"'
}

cleanup_linux()
{
  systemctl --user stop "$unit" >/dev/null 2>&1 || :
  systemctl --user disable "$unit" >/dev/null 2>&1 || :
  rm -f "$unit_path"
  systemctl --user daemon-reload >/dev/null 2>&1 || :
  rm -rf "$tmp"
}

run_linux()
{
  command -v systemctl >/dev/null 2>&1 || {
    printf '%s\n' 'RESULT linux systemctl-unavailable'
    return 0
  }
  command -v od >/dev/null 2>&1 || fail 'od unavailable'
  command -v awk >/dev/null 2>&1 || fail 'awk unavailable'

  if ! systemctl --user show-environment >/dev/null 2>&1
  then
    printf '%s\n' 'RESULT linux user-manager-unavailable'
    return 0
  fi

  prepare_relocatable_fixture

  unit=m-poc-user-host-supervision.service
  unit_dir=${HOME:?}/.config/systemd/user
  unit_path=$unit_dir/$unit
  exec_start="$(systemd_exec_arg "$bootstrap") $(systemd_exec_arg "$command")" ||
    fail 'cannot serialize systemd ExecStart'

  mkdir -p "$unit_dir" || fail 'cannot prepare linux unit directory'
  cat > "$unit_path" <<EOF_UNIT
[Unit]
Description=RumiAI PoC user host supervision

[Service]
Type=simple
ExecStart=/bin/sh $exec_start

[Install]
WantedBy=default.target
EOF_UNIT

  trap cleanup_linux 0 HUP INT TERM

  systemctl --user daemon-reload || fail 'systemd daemon-reload failed'
  systemctl --user enable "$unit" || fail 'systemd enable failed'
  [ ! -e "$bootstrap_marker" ] && [ ! -e "$command_marker" ] ||
    fail 'systemd install unexpectedly started the service'

  systemctl --user start "$unit" || {
    cat "$unit_path" >&2
    systemctl --user status "$unit" --no-pager >&2 || :
    fail 'systemd start failed'
  }
  systemctl --user is-active --quiet "$unit" || fail 'systemd unit is not active after start'
  assert_exact_invocation

  first_pid=$(systemctl --user show "$unit" -p MainPID --value) ||
    fail 'cannot read first systemd pid'
  case "$first_pid" in ""|0|*[!0123456789]*) fail 'invalid first systemd pid' ;; esac

  rm -f "$bootstrap_marker" "$command_marker"
  systemctl --user restart "$unit" || fail 'systemd restart failed'
  systemctl --user is-active --quiet "$unit" || fail 'systemd unit is not active after restart'
  assert_exact_invocation
  second_pid=$(systemctl --user show "$unit" -p MainPID --value) ||
    fail 'cannot read second systemd pid'
  [ "$first_pid" != "$second_pid" ] || fail 'systemd restart did not replace the process'

  systemctl --user stop "$unit" || fail 'systemd stop failed'
  if systemctl --user is-active --quiet "$unit"
  then
    fail 'systemd unit remained active after stop'
  fi

  systemctl --user disable "$unit" || fail 'systemd disable failed'
  rm -f "$unit_path" || fail 'cannot remove linux unit'
  systemctl --user daemon-reload || fail 'systemd final daemon-reload failed'

  trap - 0 HUP INT TERM
  rm -rf "$tmp"
  printf '%s\n' 'RESULT linux user-host-relocatable-invocation-ok'
}

cleanup_macos()
{
  launchctl bootout "$domain/$label" >/dev/null 2>&1 || :
  rm -f "$plist"
  rm -rf "$tmp"
}

run_macos()
{
  command -v launchctl >/dev/null 2>&1 || fail 'launchctl unavailable'
  command -v plutil >/dev/null 2>&1 || fail 'plutil unavailable'

  uid=$(id -u) || fail 'cannot determine uid'
  domain=gui/$uid
  label=m.poc.user-host-supervision
  agent_dir=${HOME:?}/Library/LaunchAgents
  plist=$agent_dir/$label.plist

  if ! launchctl print "$domain" >/dev/null 2>&1
  then
    printf '%s\n' "RESULT macos gui-domain-unavailable domain=$domain"
    return 0
  fi

  prepare_relocatable_fixture
  mkdir -p "$agent_dir" || fail 'cannot prepare macOS agent directory'

  plutil -create xml1 "$plist" || fail 'cannot create launchd plist'
  plutil -insert Label -string "$label" "$plist" || fail 'cannot set launchd label'
  plutil -insert ProgramArguments -array "$plist" || fail 'cannot create ProgramArguments'
  plutil -insert ProgramArguments.0 -string "$bootstrap" "$plist" ||
    fail 'cannot serialize bootstrap ProgramArgument'
  plutil -insert ProgramArguments.1 -string "$command" "$plist" ||
    fail 'cannot serialize command ProgramArgument'
  plutil -insert RunAtLoad -bool true "$plist" || fail 'cannot set RunAtLoad'
  chmod 600 "$plist" || fail 'cannot set plist mode'
  plutil -lint "$plist" >/dev/null || fail 'plist syntax invalid'

  trap cleanup_macos 0 HUP INT TERM

  launchctl enable "$domain/$label" || fail 'launchctl enable failed'
  [ ! -e "$bootstrap_marker" ] && [ ! -e "$command_marker" ] ||
    fail 'launchd install unexpectedly started the service'

  launchctl bootstrap "$domain" "$plist" || fail 'launchctl bootstrap failed'
  launchctl print "$domain/$label" >/dev/null 2>&1 || fail 'launchd service is not loaded'
  sleep 1
  assert_exact_invocation

  first_pid=$(launchctl print "$domain/$label" | awk '/^[[:space:]]*pid = / { print $3; exit }') ||
    fail 'cannot read first launchd pid'
  case "$first_pid" in ""|0|*[!0123456789]*) fail 'invalid first launchd pid' ;; esac

  launchctl bootout "$domain/$label" || fail 'launchctl stop/bootout failed'
  stop_wait=0
  while launchctl print "$domain/$label" >/dev/null 2>&1 && [ "$stop_wait" -lt 10 ]
  do
    sleep 1
    stop_wait=$((stop_wait + 1))
  done
  if launchctl print "$domain/$label" >/dev/null 2>&1
  then
    fail 'launchd service remained loaded after stop'
  fi
  [ -f "$plist" ] || fail 'launch agent plist disappeared during stop'

  rm -f "$bootstrap_marker" "$command_marker"
  launchctl bootstrap "$domain" "$plist" || fail 'launchctl start/bootstrap failed after stop'
  sleep 1
  assert_exact_invocation
  second_pid=$(launchctl print "$domain/$label" | awk '/^[[:space:]]*pid = / { print $3; exit }') ||
    fail 'cannot read second launchd pid'
  [ "$first_pid" != "$second_pid" ] || fail 'launchctl bootstrap did not start a new process after stop'

  rm -f "$bootstrap_marker" "$command_marker"
  launchctl kickstart -k "$domain/$label" || fail 'launchctl restart/kickstart failed'
  sleep 1
  assert_exact_invocation
  third_pid=$(launchctl print "$domain/$label" | awk '/^[[:space:]]*pid = / { print $3; exit }') ||
    fail 'cannot read third launchd pid'
  [ "$second_pid" != "$third_pid" ] || fail 'launchctl kickstart -k did not replace the process'

  launchctl bootout "$domain/$label" >/dev/null 2>&1 || :
  rm -f "$plist" || fail 'cannot remove launch agent plist'
  launchctl disable "$domain/$label" >/dev/null 2>&1 || :

  trap - 0 HUP INT TERM
  rm -rf "$tmp"
  printf '%s\n' 'RESULT macos user-host-relocatable-invocation-ok'
}

case $(uname -s) in
  Linux) run_linux ;;
  Darwin) run_macos ;;
  *) printf '%s\n' "RESULT unsupported-host $(uname -s)" ;;
esac
