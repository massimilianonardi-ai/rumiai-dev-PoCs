#!/bin/sh

set -u

fail()
{
  printf '%s\n' "FAIL: $*" >&2
  exit 1
}

cleanup_linux()
{
  systemctl --user stop "$unit" >/dev/null 2>&1 || :
  systemctl --user disable "$unit" >/dev/null 2>&1 || :
  rm -f "$unit_path"
  systemctl --user daemon-reload >/dev/null 2>&1 || :
  rm -rf "$tmp"
}

run_linux()
{
  command -v systemctl >/dev/null 2>&1 || {
    printf '%s\n' 'RESULT linux systemctl-unavailable'
    return 0
  }

  if ! systemctl --user show-environment >/dev/null 2>&1
  then
    printf '%s\n' 'RESULT linux user-manager-unavailable'
    return 0
  fi

  tmp=${TMPDIR:-/tmp}/rumiai-poc-user-host-$$
  unit=m-poc-user-host-supervision.service
  unit_dir=${HOME:?}/.config/systemd/user
  unit_path=$unit_dir/$unit
  payload=$tmp/payload
  marker=$tmp/marker

  mkdir -p "$tmp" "$unit_dir" || fail 'cannot prepare linux fixture'
  cat > "$payload" <<EOF_PAYLOAD
#!/bin/sh
trap 'exit 0' TERM INT HUP
printf '%s\\n' "\$\$" > "$marker"
while :
do
  sleep 1
done
EOF_PAYLOAD
  chmod 700 "$payload" || fail 'cannot make linux payload executable'

  cat > "$unit_path" <<EOF_UNIT
[Unit]
Description=RumiAI PoC user host supervision

[Service]
Type=simple
ExecStart=$payload

[Install]
WantedBy=default.target
EOF_UNIT

  trap cleanup_linux 0 HUP INT TERM

  systemctl --user daemon-reload || fail 'systemd daemon-reload failed'
  systemctl --user enable "$unit" || fail 'systemd enable failed'
  systemctl --user start "$unit" || fail 'systemd start failed'
  systemctl --user is-active --quiet "$unit" || fail 'systemd unit is not active after start'
  [ -s "$marker" ] || fail 'linux payload marker missing after start'

  first_pid=$(cat "$marker") || fail 'cannot read first linux pid'
  systemctl --user restart "$unit" || fail 'systemd restart failed'
  systemctl --user is-active --quiet "$unit" || fail 'systemd unit is not active after restart'
  second_pid=$(cat "$marker") || fail 'cannot read second linux pid'
  [ "$first_pid" != "$second_pid" ] || fail 'systemd restart did not replace the process'

  systemctl --user stop "$unit" || fail 'systemd stop failed'
  if systemctl --user is-active --quiet "$unit"
  then
    fail 'systemd unit remained active after stop'
  fi

  systemctl --user disable "$unit" || fail 'systemd disable failed'
  rm -f "$unit_path" || fail 'cannot remove linux unit'
  systemctl --user daemon-reload || fail 'systemd final daemon-reload failed'

  trap - 0 HUP INT TERM
  rm -rf "$tmp"
  printf '%s\n' 'RESULT linux user-host-lifecycle-ok'
}

cleanup_macos()
{
  launchctl bootout "$domain/$label" >/dev/null 2>&1 || :
  rm -f "$plist"
  rm -rf "$tmp"
}

run_macos()
{
  command -v launchctl >/dev/null 2>&1 || fail 'launchctl unavailable'
  command -v plutil >/dev/null 2>&1 || fail 'plutil unavailable'

  uid=$(id -u) || fail 'cannot determine uid'
  domain=gui/$uid
  label=m.poc.user-host-supervision
  tmp=${TMPDIR:-/tmp}/rumiai-poc-user-host-$$
  agent_dir=${HOME:?}/Library/LaunchAgents
  plist=$agent_dir/$label.plist
  payload=$tmp/payload
  marker=$tmp/marker

  if ! launchctl print "$domain" >/dev/null 2>&1
  then
    printf '%s\n' "RESULT macos gui-domain-unavailable domain=$domain"
    return 0
  fi

  mkdir -p "$tmp" "$agent_dir" || fail 'cannot prepare macOS fixture'
  cat > "$payload" <<EOF_PAYLOAD
#!/bin/sh
trap 'exit 0' TERM INT HUP
printf '%s\\n' "\$\$" > "$marker"
while :
do
  sleep 1
done
EOF_PAYLOAD
  chmod 700 "$payload" || fail 'cannot make macOS payload executable'

  cat > "$plist" <<EOF_PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$payload</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
EOF_PLIST
  chmod 600 "$plist" || fail 'cannot set plist mode'
  plutil -lint "$plist" >/dev/null || fail 'plist syntax invalid'

  trap cleanup_macos 0 HUP INT TERM

  launchctl enable "$domain/$label" || fail 'launchctl enable failed'
  launchctl bootstrap "$domain" "$plist" || fail 'launchctl bootstrap failed'
  launchctl print "$domain/$label" >/dev/null 2>&1 || fail 'launchd service is not loaded'
  [ -s "$marker" ] || {
    sleep 1
    [ -s "$marker" ] || fail 'macOS payload marker missing after bootstrap'
  }

  first_pid=$(cat "$marker") || fail 'cannot read first macOS pid'

  launchctl kill SIGTERM "$domain/$label" || fail 'launchctl stop signal failed'
  stop_wait=0
  while kill -0 "$first_pid" 2>/dev/null && [ "$stop_wait" -lt 10 ]
  do
    sleep 1
    stop_wait=$((stop_wait + 1))
  done
  kill -0 "$first_pid" 2>/dev/null && fail 'macOS payload remained alive after stop'
  launchctl print "$domain/$label" >/dev/null 2>&1 ||
    fail 'launchd service definition disappeared after stop'

  launchctl kickstart "$domain/$label" || fail 'launchctl start/kickstart failed'
  sleep 1
  second_pid=$(cat "$marker") || fail 'cannot read second macOS pid'
  [ "$first_pid" != "$second_pid" ] || fail 'launchctl kickstart did not start a new process'

  launchctl bootout "$domain/$label" || fail 'launchctl bootout failed for installed stop probe'
  bootout_wait=0
  while launchctl print "$domain/$label" >/dev/null 2>&1 && [ "$bootout_wait" -lt 10 ]
  do
    sleep 1
    bootout_wait=$((bootout_wait + 1))
  done
  if launchctl print "$domain/$label" >/dev/null 2>&1
  then
    fail 'launchd service remained loaded after awaited bootout'
  fi
  [ -f "$plist" ] || fail 'launch agent plist disappeared during bootout stop probe'

  launchctl bootstrap "$domain" "$plist" || fail 'launchctl bootstrap failed after bootout stop probe'
  sleep 1
  bootstrap_pid=$(cat "$marker") || fail 'cannot read bootstrap restart pid'
  [ "$second_pid" != "$bootstrap_pid" ] || fail 'launchctl bootstrap did not start a new process after bootout'

  launchctl kickstart -k "$domain/$label" || fail 'launchctl restart/kickstart failed'
  sleep 1
  third_pid=$(cat "$marker") || fail 'cannot read third macOS pid'
  [ "$second_pid" != "$third_pid" ] || fail 'launchctl kickstart -k did not replace the process'

  rm -f "$plist" || fail 'cannot remove launch agent plist'
  launchctl bootout "$domain/$label" || fail 'launchctl bootout failed during uninstall'
  uninstall_wait=0
  while launchctl print "$domain/$label" >/dev/null 2>&1 && [ "$uninstall_wait" -lt 10 ]
  do
    sleep 1
    uninstall_wait=$((uninstall_wait + 1))
  done
  if launchctl print "$domain/$label" >/dev/null 2>&1
  then
    fail 'launchd service remained loaded after uninstall'
  fi
  trap - 0 HUP INT TERM
  rm -rf "$tmp"
  printf '%s\n' 'RESULT macos user-host-lifecycle-ok'
}

case $(uname -s) in
  Linux) run_linux ;;
  Darwin) run_macos ;;
  *) printf '%s\n' "RESULT unsupported-host $(uname -s)" ;;
esac
