#!/usr/bin/env m

main()
{
  [ -n "${RUMIAI_POC_HOST_NODE-}" ] || exit 2
  poc_root=${m_COMMAND_BIN%/*}
  [ "$poc_root" != "$m_COMMAND_BIN" ] || poc_root=.
  poc_root="$(CDPATH= cd -- "$poc_root" 2>/dev/null && pwd -P)" || exit 1
  exec "$RUMIAI_POC_HOST_NODE" "$poc_root/run-once.js" "$@"
}

main "$@"
