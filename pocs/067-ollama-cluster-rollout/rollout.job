exec > "/m/src/git/rsudo-jobs.log" 2>&1

# rsudo-admin jobs: select controller.lib.sh as library, then this template.
# Review exact release pins. Default: check. Change final mode to canary or
# rollout for updates; no remote mutation occurs in check mode.
command -v cluster_rollout >/dev/null 2>&1 || {
  printf '%s\n' 'CLUSTER ERROR: selected library lacks cluster_rollout' >&2
  return 1
}

cluster_rollout \
  '9f4524d9af44cc031ba039b88cfda8d2df0e1c65' \
  '5f3edca59cdc2dd721c50856d99736392f0fff0b' \
  'f181030a940abc79aa98797c6ac13bd149d6d1cba545f1111886eea8c3445cfd' \
  check
