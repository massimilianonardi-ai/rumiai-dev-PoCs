#!/bin/sh
# initramfs-tools local-top: locate RAW file again after GRUB loopback ends.
set -eu
case "${1:-}" in
  prereqs) exit 0 ;;
esac
raw=
uuid=
for item in $(cat /proc/cmdline); do
  case "$item" in
    mboot.raw=*) raw=${item#mboot.raw=} ;;
    mboot.media_uuid=*) uuid=${item#mboot.media_uuid=} ;;
  esac
done
[ -n "$raw" ] || exit 0
case "$raw" in
  /m/boot/host/amd64/mboot-ubuntu-host.raw|/m/boot/host/arm64/mboot-ubuntu-host.raw) ;;
  *) echo MBOOT_RAW_ROOT_INVALID_PATH >&2; exit 1 ;;
esac
case "$raw" in
  *..*|*' '*|*','*) echo MBOOT_RAW_ROOT_UNSAFE_PATH >&2; exit 2 ;;
esac
case "$uuid" in
  ''|*[!0123456789abcdefABCDEF-]*)
    echo MBOOT_RAW_ROOT_INVALID_SOURCE_UUID >&2
    exit 3 ;;
esac
modprobe loop || { echo MBOOT_RAW_ROOT_LOOP_MODULE_FAIL >&2; exit 4; }
modprobe ext4 || { echo MBOOT_RAW_ROOT_EXT4_MODULE_FAIL >&2; exit 5; }
attempt=0
while [ ! -e "/dev/disk/by-uuid/$uuid" ] && [ "$attempt" -lt 15 ]; do
  sleep 1
  attempt=$((attempt + 1))
done
[ -e "/dev/disk/by-uuid/$uuid" ] || {
  echo MBOOT_RAW_ROOT_SOURCE_NOT_FOUND >&2
  exit 6
}
# Wubi/Lupin's necessary insight: the source filesystem must outlive
# initramfs. local-bottom moves /host under the real root before run-init.
mkdir -p /host
mount -t ext4 -o rw "/dev/disk/by-uuid/$uuid" /host || {
  echo MBOOT_RAW_ROOT_SOURCE_MOUNT_FAIL >&2
  exit 7
}
[ -f "/host$raw" ] || {
  echo MBOOT_RAW_ROOT_IMAGE_NOT_FOUND >&2
  exit 8
}
loopdev=$(losetup --find --show --partscan "/host$raw") || {
  echo MBOOT_RAW_ROOT_LOOP_ATTACH_FAIL >&2
  exit 9
}
attempt=0
while [ ! -b "${loopdev}p1" ] && [ "$attempt" -lt 15 ]; do
  sleep 1
  attempt=$((attempt + 1))
done
[ -b "${loopdev}p1" ] || {
  echo MBOOT_RAW_ROOT_PARTITION_NOT_FOUND >&2
  exit 10
}
ln -s "${loopdev}p1" /dev/mboot-raw-root
echo "MBOOT_RAW_ROOT_DISCOVERED=$loopdev"
