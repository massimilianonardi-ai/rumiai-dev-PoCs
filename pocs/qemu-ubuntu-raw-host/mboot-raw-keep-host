#!/bin/sh
# initramfs-tools local-bottom: preserve the ext4 filesystem backing RAW/ISO
# across run-init. Derived from the documented historical Wubi loop-root
# mount-move model; applies only to an explicit mboot.raw= boot.
set -eu
case "${1:-}" in
  prereqs) exit 0 ;;
esac
case " $(cat /proc/cmdline) " in
  *" mboot.raw="*) ;;
  *) exit 0 ;;
esac
[ -d /host ] || {
  echo MBOOT_RAW_HOST_SOURCE_MISSING >&2
  exit 1
}
[ -n "${rootmnt:-}" ] && [ -d "$rootmnt" ] || {
  echo MBOOT_RAW_ROOT_MOUNT_MISSING >&2
  exit 2
}
mkdir -p "$rootmnt/host"
mount -o move /host "$rootmnt/host" || {
  echo MBOOT_RAW_HOST_MOVE_FAILED >&2
  exit 3
}
echo MBOOT_RAW_HOST_BACKING_PRESERVED
