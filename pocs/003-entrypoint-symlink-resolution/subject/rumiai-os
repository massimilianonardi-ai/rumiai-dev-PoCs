#!/bin/sh

RumiAI_NL='
'

RumiAI_capture_line()
{
  "$@"
  RumiAI_capture_status=$?
  printf -- 'x'
  return "$RumiAI_capture_status"
}

case $0 in
  */*)
    RumiAI_BOOTSTRAP_BIN=$0
    ;;
  *)
    if ! RumiAI_BOOTSTRAP_BIN=$(RumiAI_capture_line command -v -- "$0")
    then
      printf -- '%s\n' "rumiai-os: cannot resolve bootstrap executable through PATH: $0" >&2
      exit 1
    fi
    RumiAI_BOOTSTRAP_BIN=${RumiAI_BOOTSTRAP_BIN%x}
    RumiAI_BOOTSTRAP_BIN=${RumiAI_BOOTSTRAP_BIN%"$RumiAI_NL"}
    ;;
esac

if ! RumiAI_BOOTSTRAP_BIN=$(RumiAI_capture_line realpath -- "$RumiAI_BOOTSTRAP_BIN")
then
  printf -- '%s\n' 'rumiai-os: cannot resolve physical bootstrap executable path' >&2
  exit 1
fi
RumiAI_BOOTSTRAP_BIN=${RumiAI_BOOTSTRAP_BIN%x}
RumiAI_BOOTSTRAP_BIN=${RumiAI_BOOTSTRAP_BIN%"$RumiAI_NL"}

if [ ! -f "$RumiAI_BOOTSTRAP_BIN" ]
then
  printf -- '%s\n' 'rumiai-os: resolved bootstrap executable is not an existing regular file' >&2
  exit 1
fi

RumiAI_ROOT=${RumiAI_BOOTSTRAP_BIN%/*}
[ -n "$RumiAI_ROOT" ] || RumiAI_ROOT=/

if ! (cd -- "$RumiAI_ROOT")
then
  printf -- '%s\n' 'rumiai-os: resolved root is not an accessible directory' >&2
  exit 1
fi

export RumiAI_BOOTSTRAP_BIN RumiAI_ROOT

# PoC-only observable output.
printf -- 'RumiAI_BOOTSTRAP_BIN=%s\nRumiAI_ROOT=%s\n' "$RumiAI_BOOTSTRAP_BIN" "$RumiAI_ROOT"
