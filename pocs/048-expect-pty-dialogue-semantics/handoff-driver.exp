#!/usr/bin/expect -f

if {$argc < 5} {
    puts stderr "usage: handoff-driver.exp <transcript> <status-file> <status-wrapper> -- <command> ?arg ...?"
    exit 2
}

set transcript [lindex $argv 0]
set status_file [lindex $argv 1]
set status_wrapper [lindex $argv 2]

if {[lindex $argv 3] ne "--"} {
    puts stderr "handoff-driver.exp: missing -- before child command"
    exit 2
}

set command [lrange $argv 4 end]
if {[llength $command] == 0} {
    puts stderr "handoff-driver.exp: empty child command"
    exit 2
}

set timeout 10
if {[info exists env(TESTLAB_EXPECT_POC_TIMEOUT)]} {
    set timeout $env(TESTLAB_EXPECT_POC_TIMEOUT)
}

log_user 1
log_file -noappend $transcript

spawn -noecho $status_wrapper $status_file -- {*}$command
set child_spawn_id $spawn_id

set outcome none
expect {
    -exact "auto> " {
        set outcome matched
    }
    timeout {
        set outcome timeout
    }
    eof {
        set outcome eof
    }
}

if {$outcome ne "matched"} {
    log_file
    if {$outcome eq "timeout"} {
        puts stderr "handoff-driver.exp: timeout waiting for automated setup prompt"
        exit 124
    }
    puts stderr "handoff-driver.exp: child reached EOF before automated setup prompt"
    exit 125
}

send -- "automated\r"

set outcome none
expect {
    -exact "handoff-ready" {
        set outcome matched
    }
    timeout {
        set outcome timeout
    }
    eof {
        set outcome eof
    }
}

if {$outcome ne "matched"} {
    log_file
    if {$outcome eq "timeout"} {
        puts stderr "handoff-driver.exp: timeout waiting for handoff readiness"
        exit 124
    }
    puts stderr "handoff-driver.exp: child reached EOF before handoff readiness"
    exit 125
}

set operator_tty_restore ""

proc restore_operator_tty {} {
    global operator_tty_restore

    if {$operator_tty_restore ne ""} {
        catch {eval stty $operator_tty_restore}
        set operator_tty_restore ""
    }
}

proc acquire_operator {takeover_token} {
    global operator_tty_restore timeout

    if {![info exists ::tty_spawn_id]} {
        error "handoff-driver.exp: controlling terminal /dev/tty is unavailable"
    }

    set operator_tty_restore [stty raw echo]
    set saved_timeout $timeout
    set timeout -1

    send_tty -- "driver:take-control> type $takeover_token and press Enter: "

    expect_tty {
        -exact "$takeover_token\r" {
            set timeout $saved_timeout
            stty raw -echo
            send_tty -- "\r\n"
            return
        }
        eof {
            set timeout $saved_timeout
            error "handoff-driver.exp: controlling terminal reached EOF before takeover"
        }
    }
}

set takeover_token "takeover-[pid]"

if {[catch {acquire_operator $takeover_token} takeover_error]} {
    restore_operator_tty
    log_file
    puts stderr $takeover_error
    exit 127
}

send -- "handoff-start\r"

set outcome none
expect {
    -exact "human> " {
        set outcome matched
    }
    timeout {
        set outcome timeout
    }
    eof {
        set outcome eof
    }
}

if {$outcome ne "matched"} {
    log_file
    if {$outcome eq "timeout"} {
        puts stderr "handoff-driver.exp: timeout waiting for human prompt"
        exit 124
    }
    puts stderr "handoff-driver.exp: child reached EOF before human prompt"
    exit 125
}

puts "driver:handoff"
flush stdout

proc operator_handoff {child_spawn_id} {
    global tty_spawn_id

    if {![info exists tty_spawn_id]} {
        error "handoff-driver.exp: controlling terminal /dev/tty is unavailable"
    }

    interact \
        -input $tty_spawn_id \
            "__TESTLAB_RETURN__" { return } \
            eof { error "handoff-driver.exp: controlling terminal reached EOF during handoff" } \
            -output $child_spawn_id \
        -input $child_spawn_id \
            eof { error "handoff-driver.exp: child reached EOF during operator handoff" } \
            -output $tty_spawn_id
}

if {[catch {operator_handoff $child_spawn_id} handoff_error]} {
    restore_operator_tty
    log_file
    puts stderr $handoff_error
    exit 127
}

restore_operator_tty

puts "driver:resumed"
flush stdout

send -- "automated-finish\r"

set outcome none
expect {
    -exact "handoff-done" {
        set outcome matched
    }
    timeout {
        set outcome timeout
    }
    eof {
        set outcome eof
    }
}

if {$outcome ne "matched"} {
    log_file
    if {$outcome eq "timeout"} {
        puts stderr "handoff-driver.exp: timeout waiting for post-handoff completion"
        exit 124
    }
    puts stderr "handoff-driver.exp: child reached EOF before post-handoff completion"
    exit 125
}

expect eof
catch {wait}
log_file

if {[catch {open $status_file r} fh]} {
    puts stderr "handoff-driver.exp: child status record is unavailable"
    exit 126
}

set count [gets $fh value]
close $fh

if {$count < 1 || ![string is integer -strict $value] || $value < 0 || $value > 255} {
    puts stderr "handoff-driver.exp: invalid child status record"
    exit 126
}

exit 0
